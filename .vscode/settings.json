{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/Thumbs.db": true,
    ".expo": true,
    ".vscode": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "jest.config.ts": "jest.*",
    "eslint.config.js": "eslint.*"
  },
  "keyboard.touchbar.ignored": [
    "workbench.action.debug.start",
    "workbench.action.debug.run",
    "touchbar.editor.action.jumpToBracket",
    "touchbar.workbench.action.toggleSidebarVisibility",
    "touchbar.editor.action.copyLinesDownAction",
    "touchbar.workbench.action.showCommands",
    "touchbar.workbench.action.splitEditor",
    "touchbar.workbench.action.terminal.toggleTerminal",
    "touchbar.editor.action.blockComment"
  ]
}
