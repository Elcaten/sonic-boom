{
  "version": "0.1.0",
  "profile_name": "mixed_mode",
  "test_runner_configurations": {
    "specs/utils.cs.md": {
      "run_all_tests_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.hooks-and-utils.test_command.ts",
        "cwd": "."
      },
      "run_specified_tests_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.hooks-and-utils.test_command.ts {tests_list}",
        "cwd": "."
      },
      "run_all_tests_with_coverage_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.hooks-and-utils.coverage_command.ts; _EC=$?; [ -f .coverage/hooks-and-utils/lcov.info ] && cp .coverage/hooks-and-utils/lcov.info {tests_coverage_report_file}; rm -rf .coverage/hooks-and-utils; exit $_EC",
        "cwd": "."
      },
      "run_specified_tests_with_coverage_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.hooks-and-utils.coverage_command.ts {tests_list}; _EC=$?; [ -f .coverage/hooks-and-utils/lcov.info ] && cp .coverage/hooks-and-utils/lcov.info {tests_coverage_report_file}; rm -rf .coverage/hooks-and-utils; exit $_EC",
        "cwd": "."
      },
      "non_test_source_regex_include": [
        "\\.ts$",
        "\\.tsx$"
      ],
      "non_test_source_regex_exclude": [
        "\\.test\\.ts$",
        "\\.test\\.tsx$",
        "\\.spec\\.ts$",
        "\\.spec\\.tsx$",
        "(^|/)__test__/"
      ],
      "source_glob_patterns": [
        "**/*.ts",
        "**/*.tsx"
      ]
    },
    "specs/api-client.cs.md": {
      "run_all_tests_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.context-and-hooks.test_command.ts",
        "cwd": "."
      },
      "run_specified_tests_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.context-and-hooks.test_command.ts {tests_list}",
        "cwd": "."
      },
      "run_all_tests_with_coverage_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.context-and-hooks.coverage_command.ts; _EC=$?; [ -f .coverage/context-and-hooks/lcov.info ] && cp .coverage/context-and-hooks/lcov.info {tests_coverage_report_file}; rm -rf .coverage/context-and-hooks; exit $_EC",
        "cwd": "."
      },
      "run_specified_tests_with_coverage_command": {
        "command_line": "JEST_JUNIT_OUTPUT_FILE={tests_report_file} npx jest --config=jest.context-and-hooks.coverage_command.ts {tests_list}; _EC=$?; [ -f .coverage/context-and-hooks/lcov.info ] && cp .coverage/context-and-hooks/lcov.info {tests_coverage_report_file}; rm -rf .coverage/context-and-hooks; exit $_EC",
        "cwd": "."
      },
      "non_test_source_regex_include": [
        "\\.ts$",
        "\\.tsx$"
      ],
      "non_test_source_regex_exclude": [
        "\\.test\\.ts$",
        "\\.test\\.tsx$",
        "\\.spec\\.ts$",
        "\\.spec\\.tsx$",
        "(^|/)__test__/"
      ],
      "source_glob_patterns": [
        "**/*.ts",
        "**/*.tsx"
      ]
    }
  }
}